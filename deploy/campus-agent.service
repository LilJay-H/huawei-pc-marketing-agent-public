[Unit]
Description=Campus PC marketing agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=campus-agent
Group=campus-agent
WorkingDirectory=/opt/campus-agent/current
EnvironmentFile=/etc/campus-agent/environment
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /opt/campus-agent/current/server.py
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/campus-agent
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
MemoryHigh=256M
MemoryMax=384M
CPUQuota=50%
TasksMax=64
Nice=10

[Install]
WantedBy=multi-user.target
